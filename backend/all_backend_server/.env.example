APP_NAME=HMS All Backend Server
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000

# Three existing databases (same names as before - no data migration required)
AUTH_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/Demo%20Project%201
SCHEDULE_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/hms_schedule
AUDIT_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/audit_server

# Must be a long random secret (same JWT secret previously shared across services)
SECRET_KEY=change-me-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
LOGIN_RATE_LIMIT=10/minute

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@hospital.local
ADMIN_PASSWORD=Admin@123
ADMIN_FULL_NAME=System Administrator

# Optional: external machine ingest to POST /api/v1/audit/events
AUDIT_SERVICE_TOKEN=change-me-to-a-long-random-ingest-token
AUDIT_EMIT_ENABLED=true

# Appointment free-slot grid (minutes)
APPOINTMENT_SLOT_MINUTES=30

# Transactional email (Resend) - leave RESEND_API_KEY empty to disable sends
EMAIL_ENABLED=true
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=Hospital Management System
HOSPITAL_DISPLAY_NAME=Hospital Management System
FRONTEND_LOGIN_URL=http://127.0.0.1:3000/login

# Frontend Metal Unfold loader (GET /api/v1/public/ui-config)
UI_LOADER_ENABLED=true
UI_LOADER_MODE=both
UI_LOADER_BACKGROUND=rgba(244, 244, 245, 0.94)
UI_LOADER_BASE_COLOR=#059669
UI_LOADER_SPEED=50
UI_LOADER_DISTANCE=11
UI_LOADER_MATERIAL_ROUGHNESS=100
UI_LOADER_MATERIAL_REFLECT=100
UI_LOADER_MOTION_SPIN=90
UI_LOADER_MOTION_FOLD=90
UI_LOADER_MOTION_HOLD=50
UI_LOADER_CAMERA_TILT=18
UI_LOADER_CAMERA_SIDE_TILT=0

# Login offline play while GET /health is unreachable (GET /api/v1/public/ui-config)
UI_OFFLINE_PLAY_ENABLED=true
UI_OFFLINE_MESSAGE=Can't reach the server — play while we reconnect
UI_OFFLINE_RECONNECT_MESSAGE=Server is back — continue
UI_OFFLINE_RECONNECT_NOTICE_MS=1000
UI_OFFLINE_FAIL_THRESHOLD=2
UI_OFFLINE_SUCCESS_THRESHOLD=1
UI_OFFLINE_POLL_INTERVAL_ONLINE_MS=15000
UI_OFFLINE_POLL_INTERVAL_OFFLINE_MS=4000
UI_OFFLINE_REQUEST_TIMEOUT_MS=4000
UI_OFFLINE_GAME_BACKGROUND=#00484C
UI_OFFLINE_GAME_INK=#FFFFFF
UI_OFFLINE_GAME_START_SPEED=620
UI_OFFLINE_GAME_JUMP=1840
