# Schedule service — clinical / appointments domain.
# Copy to .env and fill values. Never commit .env.

APP_NAME=HMS Schedule Service
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8001

# Dedicated Schedule database (NOT the auth DB)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/hms_schedule

# Must match auth_server SECRET_KEY / ALGORITHM so JWTs validate
SECRET_KEY=change-me-to-match-auth-server-secret
ALGORITHM=HS256

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
