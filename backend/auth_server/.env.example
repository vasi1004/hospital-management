APP_NAME=Hospital Management System
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# URL-encode spaces in the database name (Demo Project 1 -> Demo%20Project%201)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/Demo%20Project%201

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated frontend origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Login rate limit (requests per minute per IP)
LOGIN_RATE_LIMIT=10/minute

# One-time admin seed (used by scripts/seed_admin.py and scripts/seed_hms_users.py)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@hospital.local
ADMIN_PASSWORD=Admin@123
ADMIN_FULL_NAME=System Administrator
